{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component.schema.json",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/button.json",
  "specVersion": "1.0.0-draft",
  "name": "button",
  "displayName": "Button",
  "description": "Buttons allow users to perform an action or to navigate to another page.",
  "meta": {
    "category": "actions",
    "documentationUrl": "https://spectrum.adobe.com/page/button/"
  },
  "documentBlocks": [
    {
      "type": "purpose",
      "content": "Buttons allow users to perform an action or to navigate to another page."
    }
  ],
  "implementations": [
    {
      "platform": "web",
      "componentName": "Button",
      "package": "@react-spectrum/s2"
    },
    {
      "platform": "web",
      "componentName": "Button",
      "importPath": "@adobe/spectrum-wc/components/button",
      "notes": "Spectrum 2 web component custom element: swc-button."
    }
  ],
  "options": {
    "variant": {
      "type": "string",
      "default": "accent",
      "description": "Visual emphasis level.",
      "values": [
        {
          "value": "accent"
        },
        {
          "value": "negative"
        },
        {
          "value": "primary"
        },
        {
          "value": "secondary"
        }
      ]
    },
    "style": {
      "type": "string",
      "default": "fill",
      "values": [
        {
          "value": "fill"
        },
        {
          "value": "outline"
        }
      ]
    },
    "size": {
      "type": "string",
      "default": "m",
      "values": [
        {
          "value": "s"
        },
        {
          "value": "m"
        },
        {
          "value": "l"
        },
        {
          "value": "xl"
        }
      ]
    },
    "isDisabled": {
      "type": "boolean",
      "default": false
    },
    "isPending": {
      "type": "boolean",
      "default": false
    },
    "isLabelHidden": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "$ref": "https://opensource.adobe.com/spectrum-design-data/schemas/types/workflow-icon.json",
      "description": "Icon placed at the start of the button. Required when isLabelHidden is true."
    },
    "staticColor": {
      "type": "string",
      "description": "Static color for use on colored backgrounds.",
      "values": [
        {
          "value": "white"
        },
        {
          "value": "black"
        }
      ]
    }
  },
  "slots": [
    {
      "name": "default",
      "description": "Text label of the button.",
      "required": false
    },
    {
      "name": "icon",
      "description": "Icon placed at the start of the button."
    }
  ],
  "states": [
    {
      "name": "hover",
      "trigger": "interaction",
      "precedence": 50
    },
    {
      "name": "down",
      "trigger": "interaction",
      "precedence": 55
    },
    {
      "name": "focus",
      "trigger": "interaction",
      "precedence": 60,
      "layered": true
    },
    {
      "name": "disabled",
      "trigger": "prop",
      "precedence": 100
    }
  ],
  "lifecycle": {
    "introduced": "1.0.0-draft"
  },
  "tokenBindings": [
    {
      "token": "corner-radius-button-small",
      "context": "Rounding (with wrapping)"
    },
    {
      "token": "corner-radius-button-large",
      "context": "Rounding (with wrapping)"
    },
    {
      "token": "corner-radius-button-extra-large",
      "context": "Rounding (with wrapping)"
    }
  ],
  "accessibility": {
    "role": "button",
    "intents": [
      "trigger"
    ],
    "focusable": true,
    "keyboardIntents": [
      "activate"
    ],
    "wcag": [
      {
        "criterion": "2.1.1",
        "level": "A",
        "title": "Keyboard"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "title": "Name, Role, Value"
      }
    ]
  }
}