{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Carbon Design System theme tokens for the White theme.",
  "$extensions": {
    "com.ibm.carbon": {
      "color-scheme": "light",
      "contextual": [
        "layer",
        "layer-active",
        "layer-hover",
        "layer-selected",
        "layer-selected-hover",
        "layer-accent",
        "layer-accent-hover",
        "layer-accent-active",
        "field",
        "field-hover",
        "border-subtle",
        "border-subtle-selected",
        "border-strong",
        "border-tile"
      ]
    }
  },
  "background": {
    "$type": "color",
    "$value": "{white}",
    "$description": "Default page background color. Use as the base surface for the entire application or page.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "layer-set": "base"
      }
    }
  },
  "background-active": {
    "$type": "color",
    "$value": {
      "colorSpace": {
        "$ref": "#/gray/50/$value/colorSpace"
      },
      "components": {
        "$ref": "#/gray/50/$value/components"
      },
      "alpha": 0.5
    },
    "$description": "Background color for active/pressed state. Use when user clicks or presses interactive elements.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "state": "active"
      }
    }
  },
  "layer-01": {
    "$type": "color",
    "$value": "{gray.10}",
    "$description": "Primary layer background",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Layer",
        "properties": [
          "background"
        ],
        "layer-set": "01"
      }
    }
  },
  "border-subtle-00": {
    "$type": "color",
    "$value": "{gray.20}",
    "$description": "Subtle border color for base layer. Use for low-contrast borders on page background.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Borders",
        "properties": [
          "border"
        ],
        "layer-set": "base"
      }
    }
  },
  "text-primary": {
    "$type": "color",
    "$value": "{gray.100}",
    "$description": "Primary. Token for primary in the design system.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Text",
        "properties": [
          "text"
        ]
      }
    }
  }
}