# PostgreSQL connection (local dev: docker compose up -d db, or a local Postgres 16 with pg_trgm)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas

# Bearer token required for /ops mutations and /api/ops/* (retry jobs, trigger runs).
# Leave unset in dev to allow localhost-only access.
ATLAS_ADMIN_TOKEN=

# Polite crawler identity. Sent as User-Agent on every ingestion request.
ATLAS_USER_AGENT="ATLAS-DesignSystemIndexer/0.1 (+https://github.com/zacker3310/brand/tree/main/atlas)"

# Per-host minimum delay between requests (ms) and max concurrent requests per host.
ATLAS_HOST_DELAY_MS=750
ATLAS_HOST_CONCURRENCY=2

# Raw fetch cache (content-addressed, gitignored, never served). Used for re-parse without refetch.
ATLAS_CACHE_DIR=.cache/sources

# Optional: embeddings provider for semantic search (not required; feature is off when unset).
ATLAS_EMBEDDINGS_PROVIDER=
